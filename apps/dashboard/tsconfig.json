{
 "extends": "../../tsconfig.json",
 "compilerOptions": {
  "lib": ["ESNext", "DOM", "DOM.Iterable"],
  "types": ["bun", "vite/client"],
  "jsx": "react-jsx",
  "ignoreDeprecations": "6.0",
  "baseUrl": ".",
  "paths": {
   "@/*": ["src/*"],
   "@components/*": ["src/components/*"],
   "@routes/*": ["src/routes/*"],
   "@styles/*": ["src/styles/*"]
  }
 },
 "include": ["src"]
}
