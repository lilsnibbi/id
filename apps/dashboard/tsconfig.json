{
 "compilerOptions": {
  "target": "ES2022",
  "lib": ["ES2022", "DOM", "DOM.Iterable"],
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "jsx": "react-jsx",
  "strict": true,
  "noEmit": true,
  "skipLibCheck": true,
  "paths": {
   "@/*": ["./src/*"],
   "@components/*": ["./src/components/*"],
   "@routes/*": ["./src/routes/*"],
   "@styles/*": ["./src/styles/*"]
  }
 },
 "include": ["src"],
 "exclude": ["worker.ts", "worker-configuration.d.ts"]
}
