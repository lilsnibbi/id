{
 "extends": "../../tsconfig.json",
 "compilerOptions": {
  "lib": ["ESNext", "DOM", "DOM.Iterable"],
  "types": ["bun", "vite/client"],
  "jsx": "react-jsx",
  "composite": true,
  "declaration": true,
  "noEmit": false,
  "paths": {
   "@/*": ["./src/*"],
   "@components/*": ["./src/components/*"],
   "@routes/*": ["./src/routes/*"],
   "@styles/*": ["./src/styles/*"]
  }
 },
 "include": ["src"]
}
