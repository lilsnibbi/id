{
 "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
 "vcs": {
  "enabled": false,
  "clientKind": "git",
  "useIgnoreFile": false
 },
 "files": {
  "ignoreUnknown": false,
  "includes": [
   "**",
   "!**/worker-configuration.d.ts",
   "!./bun.lock",
   "!./biome.json",
   "!apps/api/drizzle",
   "!apps/dashboard/dist"
  ]
 },
 "formatter": {
  "enabled": true,
  "indentStyle": "tab"
 },
 "overrides": [
  {
   "includes": ["**/*.json"],
   "formatter": {
    "indentStyle": "space",
    "indentWidth": 1
   }
  }
 ],
 "linter": {
  "enabled": true,
  "rules": {
   "preset": "recommended"
  }
 },
 "javascript": {
  "formatter": {
   "quoteStyle": "double"
  }
 },
 "assist": {
  "enabled": false,
  "actions": {
   "source": {
    "organizeImports": "on"
   }
  }
 }
}
