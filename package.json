{
 "private": true,
 "workspaces": [
  "apps/*"
 ],
 "scripts": {
  "format": "bunx biome format --write .",
  "check": "bunx biome check .",
  "check:fix": "bunx biome check . --fix",
  "setup": "bun run setup:config && bun run setup:d1 && bun run setup:flagship",
  "setup:config": "bun scripts/setup-wrangler.ts",
  "argon:on": "bun scripts/set-argon.ts on",
  "argon:off": "bun scripts/set-argon.ts off",
  "setup:flagship": "bun scripts/setup-flagship.ts",
  "setup:d1": "bun scripts/setup-d1.ts",
  "dev:dashboard": "bun --cwd=apps/dashboard run dev",
  "dev:api": "bun --cwd=apps/api run dev",
  "build:dashboard": "bun --cwd=apps/dashboard run build",
  "typecheck": "bunx tsc --build",
  "typecheck:dashboard": "bunx tsc -p apps/dashboard/tsconfig.json --noEmit",
  "typecheck:api": "bunx tsc -p apps/api/tsconfig.json --noEmit",
  "deploy:dashboard": "bun run build:dashboard && bun --cwd=apps/dashboard run deploy",
  "deploy:api": "bun --cwd=apps/api run deploy",
  "deploy": "bun run typecheck && bun run deploy:api && bun run deploy:dashboard"
 },
 "devDependencies": {
  "@biomejs/biome": "^2.5.11",
  "@types/bun": "^1.4.0",
  "@types/react": "^19.2.18",
  "@types/react-dom": "^19.2.5",
  "stylelint": "^17.14.1",
  "stylelint-config-standard": "^40.0.0",
  "typescript": "^7.0.2"
 },
 "dependencies": {
  "@simplewebauthn/browser": "^13.3.0",
  "@simplewebauthn/server": "^13.3.3",
  "@simplewebauthn/types": "^12.0.0",
  "wrangler": "^4.128.0"
 }
}
